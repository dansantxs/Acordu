{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(gh api -X PUT repos/*/pulls/*/merge:*)",
      "Bash(gh api --method PUT repos/*/pulls/*/merge:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(git branch -D:*)",
      "Bash(git push origin --delete:*)",
      "Bash(git push --delete:*)"
    ],
    "ask": [
      "Bash(gh workflow run deploy.yml:*)",
      "Bash(gh workflow run deploy:*)",
      "Bash(gh workflow run backup.yml:*)",
      "Bash(gh api -X POST repos/*/actions/workflows/deploy.yml/dispatches:*)"
    ]
  }
}
