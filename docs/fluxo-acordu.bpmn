<bpmn:sequenceFlow id="f11c" name="Cancelar" sourceRef="g_sit" targetRef="e_cancela"/>
<bpmn:sequenceFlow id="f12" sourceRef="s_tel" targetRef="t_registra"/>
<bpmn:sequenceFlow id="f13" sourceRef="t_registra" targetRef="t_proto"/>
