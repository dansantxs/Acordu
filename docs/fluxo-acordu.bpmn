<bpmn:sequenceFlow id="f15" sourceRef="t_proto" targetRef="t_triar"/>
<bpmn:sequenceFlow id="f16" sourceRef="t_triar" targetRef="t_tarefas"/>
<bpmn:sequenceFlow id="f17" sourceRef="t_tarefas" targetRef="t_exec"/>
<bpmn:sequenceFlow id="f18" sourceRef="tm_rec" targetRef="t_rec"/>
<bpmn:sequenceFlow id="f19" sourceRef="t_rec" targetRef="t_exec"/>
<bpmn:sequenceFlow id="f20" sourceRef="t_exec" targetRef="g_cli"/>
<bpmn:sequenceFlow id="f21" name="Sim: AGUARDANDO_CLIENTE" sourceRef="g_cli" targetRef="t_resp"/>
<bpmn:sequenceFlow id="f22" name="Respondeu" sourceRef="t_resp" targetRef="t_exec"/>
<bpmn:sequenceFlow id="f23" name="Não" sourceRef="g_cli" targetRef="t_resolver"/>
<bpmn:sequenceFlow id="f24" sourceRef="t_resolver" targetRef="t_avisa"/>
<bpmn:sequenceFlow id="f25" sourceRef="t_avisa" targetRef="g_apr"/>
<bpmn:sequenceFlow id="f26" name="Aprova" sourceRef="g_apr" targetRef="t_fechar"/>
<bpmn:sequenceFlow id="f27" name="Reprova: reabre" sourceRef="g_apr" targetRef="t_exec"/>
<bpmn:sequenceFlow id="f28" sourceRef="t_fechar" targetRef="e_fim"/>
</bpmn:process><bpmndi:BPMNDiagram id="dg"><bpmndi:BPMNPlane id="pl" bpmnElement="colab">
