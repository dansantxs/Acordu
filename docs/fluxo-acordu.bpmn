<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_acordu" targetNamespace="https://acordu.app.br/bpmn">
<bpmn:collaboration id="colab"><bpmn:participant id="pool" name="Fluxo de negócio: da entrada da empresa ao fechamento da solicitação" processRef="proc"/></bpmn:collaboration>
<bpmn:process id="proc" isExecutable="false"><bpmn:laneSet id="ls">
<bpmn:lane id="lane0" name="Operação Nebrys"><bpmn:flowNodeRef>s_neb</bpmn:flowNodeRef><bpmn:flowNodeRef>t_convite</bpmn:flowNodeRef><bpmn:flowNodeRef>t_decide</bpmn:flowNodeRef><bpmn:flowNodeRef>g_sit</bpmn:flowNodeRef><bpmn:flowNodeRef>e_ativa</bpmn:flowNodeRef><bpmn:flowNodeRef>e_prorroga</bpmn:flowNodeRef><bpmn:flowNodeRef>e_cancela</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="lane1" name="Dono da empresa"><bpmn:flowNodeRef>t_cadastro</bpmn:flowNodeRef><bpmn:flowNodeRef>t_confirma</bpmn:flowNodeRef><bpmn:flowNodeRef>t_config</bpmn:flowNodeRef><bpmn:flowNodeRef>t_convp</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="lane2" name="Equipe (atendente/executor)"><bpmn:flowNodeRef>s_tel</bpmn:flowNodeRef><bpmn:flowNodeRef>t_registra</bpmn:flowNodeRef><bpmn:flowNodeRef>t_triar</bpmn:flowNodeRef><bpmn:flowNodeRef>t_tarefas</bpmn:flowNodeRef><bpmn:flowNodeRef>t_exec</bpmn:flowNodeRef><bpmn:flowNodeRef>g_cli</bpmn:flowNodeRef><bpmn:flowNodeRef>t_resolver</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="lane3" name="Contato do cliente (portal)"><bpmn:flowNodeRef>t_aceita</bpmn:flowNodeRef><bpmn:flowNodeRef>t_abre</bpmn:flowNodeRef><bpmn:flowNodeRef>t_resp</bpmn:flowNodeRef><bpmn:flowNodeRef>g_apr</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="lane4" name="Sistema (jobs e e-mails)"><bpmn:flowNodeRef>t_cria</bpmn:flowNodeRef><bpmn:flowNodeRef>tm_fim</bpmn:flowNodeRef><bpmn:flowNodeRef>t_vencer</bpmn:flowNodeRef><bpmn:flowNodeRef>t_proto</bpmn:flowNodeRef><bpmn:flowNodeRef>tm_rec</bpmn:flowNodeRef><bpmn:flowNodeRef>t_rec</bpmn:flowNodeRef><bpmn:flowNodeRef>t_avisa</bpmn:flowNodeRef><bpmn:flowNodeRef>t_fechar</bpmn:flowNodeRef><bpmn:flowNodeRef>e_fim</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="s_neb" name="Prestador quer usar o Acordu"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
<bpmn:task id="t_convite" name="Emitir convite de empresa"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:task>
<bpmn:task id="t_cadastro" name="Cadastrar empresa: CPF/CNPJ, senha, aceite dos termos"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:task>
<bpmn:task id="t_cria" name="Criar empresa em TESTE (30 dias) e enviar confirmação"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:task>
<bpmn:task id="t_confirma" name="Confirmar e-mail (libera convites e e-mails)"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing></bpmn:task>
<bpmn:startEvent id="tm_fim" name="Fim do teste (job diário)"><bpmn:outgoing>f9</bpmn:outgoing><bpmn:timerEventDefinition id="td_tm_fim"/></bpmn:startEvent>
<bpmn:task id="t_vencer" name="Vencer: VENCIDA, só leitura; Donos avisados"><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:task>
<bpmn:task id="t_config" name="Configurar: horário útil, equipe, clientes, contratos e SLA"><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing></bpmn:task>
<bpmn:task id="t_decide" name="Decidir a situação (também durante o TESTE)"><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="g_sit" name="Decisão"><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f11a</bpmn:outgoing><bpmn:outgoing>f11b</bpmn:outgoing><bpmn:outgoing>f11c</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="e_ativa" name="ATIVA"><bpmn:incoming>f11a</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="e_prorroga" name="Prorrogada: volta a TESTE com novo fim"><bpmn:incoming>f11b</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="e_cancela" name="CANCELADA: só leitura, reativável até o expurgo"><bpmn:incoming>f11c</bpmn:incoming></bpmn:endEvent>
<bpmn:task id="t_convp" name="Convidar contato do cliente para o portal"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing></bpmn:task>
<bpmn:task id="t_aceita" name="Aceitar convite e criar acesso ao portal"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing></bpmn:task>
<bpmn:startEvent id="s_tel" name="Cliente pede por telefone, e-mail, WhatsApp"><bpmn:outgoing>f12</bpmn:outgoing></bpmn:startEvent>
<bpmn:task id="t_registra" name="Registrar solicitação"><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f13</bpmn:outgoing></bpmn:task>
<bpmn:task id="t_abre" name="Abrir solicitação no portal"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing></bpmn:task>
<bpmn:task id="t_proto" name="Gerar protocolo, ligar o SLA e avisar (ABERTA)"><bpmn:incoming>f13</bpmn:incoming><bpmn:incoming>f14</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing></bpmn:task>
<bpmn:task id="t_triar" name="Triar e dar a 1ª resposta (EM_ANDAMENTO)"><bpmn:incoming>f15</bpmn:incoming><bpmn:outgoing>f16</bpmn:outgoing></bpmn:task>
<bpmn:startEvent id="tm_rec" name="Todo dia (job)"><bpmn:outgoing>f18</bpmn:outgoing><bpmn:timerEventDefinition id="td_tm_rec"/></bpmn:startEvent>
<bpmn:task id="t_rec" name="Gerar tarefas das recorrências"><bpmn:incoming>f18</bpmn:incoming><bpmn:outgoing>f19</bpmn:outgoing></bpmn:task>
<bpmn:task id="t_tarefas" name="Criar tarefas da solicitação"><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f17</bpmn:outgoing></bpmn:task>
<bpmn:task id="t_exec" name="Executar tarefa e apontar horas (cronômetro)"><bpmn:incoming>f17</bpmn:incoming><bpmn:incoming>f19</bpmn:incoming><bpmn:incoming>f22</bpmn:incoming><bpmn:incoming>f27</bpmn:incoming><bpmn:outgoing>f20</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="g_cli" name="Precisa de algo do cliente?"><bpmn:incoming>f20</bpmn:incoming><bpmn:outgoing>f21</bpmn:outgoing><bpmn:outgoing>f23</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="t_resp" name="Responder no portal (SLA pausado enquanto aguarda)"><bpmn:incoming>f21</bpmn:incoming><bpmn:outgoing>f22</bpmn:outgoing></bpmn:task>
<bpmn:task id="t_resolver" name="Resolver com a solução (RESOLVIDA)"><bpmn:incoming>f23</bpmn:incoming><bpmn:outgoing>f24</bpmn:outgoing></bpmn:task>
<bpmn:task id="t_avisa" name="Avisar o contato: entrega aguardando aprovação"><bpmn:incoming>f24</bpmn:incoming><bpmn:outgoing>f25</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="g_apr" name="Aprova a entrega?"><bpmn:incoming>f25</bpmn:incoming><bpmn:outgoing>f26</bpmn:outgoing><bpmn:outgoing>f27</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="t_fechar" name="Fechar (FECHADA): na aprovação ou N dias corridos depois, pelo job"><bpmn:incoming>f26</bpmn:incoming><bpmn:outgoing>f28</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="e_fim" name="Solicitação fechada; horas no extrato do contrato"><bpmn:incoming>f28</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="f1" sourceRef="s_neb" targetRef="t_convite"/>
